# Ignore all files/folders in the root by default
/*

# Allow tracking of only the extension folder, README, and .gitignore
!.gitignore
!README.md
!zen-code-ambience/
!zen-ambiator.ps1
!zen-ambiator.zsh
!zen-ambiator-macos.command
!zen-ambiator-macos.app/
!vscode-extension/
!docs/chrome/
!docs/vscode/
!docs/macos/
!docs/index.html
!docs/manifest.json
!docs/sw.js
!docs/icons/
!INSTALL.md

# Local environment files (do NOT commit your real keys)
.env
.env.local
.env.*.local
